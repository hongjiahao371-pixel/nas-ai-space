TZ=Asia/Shanghai
NAS_AI_PORT=8766
NAS_LIBRARY_PATH=/path/to/your/library
NAS_VIDEO_PATH=/path/to/your/videos
NAS_UPLOAD_PATH=/path/to/your/nas-ai-uploads
NAS_RECYCLE_PATH=/path/to/your/nas-ai-recycle
NAS_AI_API_TOKEN=replace-with-a-long-random-token
NAS_AI_ALLOW_QUERY_TOKEN=false
NAS_AI_MAX_UPLOAD_GB=20

NAS_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
NAS_AI_EMBEDDING_PARALLEL=1
NAS_AI_EMBEDDING_CTX_SIZE=2048
NAS_AI_EMBEDDING_BATCH_SIZE=128
NAS_AI_EMBEDDING_UBATCH_SIZE=64
NAS_AI_EMBEDDING_GPU_LAYERS=99
NAS_AI_VISION_MODEL=qwen3-vl:2b
NAS_AI_VISION_GGUF=Qwen3-VL-2B-Instruct-Q8_0.gguf
NAS_AI_CHAT_MODEL=qwen3-vl:2b
# These normally use the bundled Ollama service. They can point at separate local OpenAI-compatible runtimes.
NAS_AI_EMBEDDING_URL=http://ollama:11434
NAS_AI_VISION_URL=http://ollama:11434
NAS_AI_CHAT_URL=http://ollama:11434
NAS_AI_TRANSCRIPTION_URL=http://speaches:8000
NAS_AI_TRANSCRIPTION_MODEL=Systran/faster-whisper-small

NAS_AI_TASK_WORKERS=0
NAS_AI_INDEX_WORKERS=0
NAS_AI_INDEX_BATCH_SIZE=200
NAS_AI_MIN_AVAILABLE_MEMORY_MB=1024
NAS_AI_MIN_FREE_SWAP_MB=512
NAS_AI_INDEX_RETRY_MAX_ATTEMPTS=3
NAS_AI_INDEX_RETRY_BASE_SECONDS=300
NAS_AI_AUTO_INDEX_ENABLED=false
NAS_AI_AUTO_INDEX_START_HOUR=0
NAS_AI_AUTO_INDEX_END_HOUR=7
NAS_AI_AUTO_INDEX_BATCH_SIZE=200
NAS_AI_TASK_RETENTION_DAYS=30
NAS_AI_TASK_RETENTION_COUNT=2000
NAS_AI_AUTOMATIC_BACKUP_ENABLED=true
NAS_AI_AUTOMATIC_BACKUP_INTERVAL_HOURS=24
NAS_AI_AUTOMATIC_BACKUP_RETENTION=7
NAS_AI_WATCH_ENABLED=true
NAS_AI_WATCH_DEBOUNCE_SECONDS=5
NAS_AI_WATCH_POLL_SECONDS=30
NAS_AI_WATCH_FALLBACK_SECONDS=900
SPEECH_IDLE_UNLOAD_SECONDS=600
NAS_AI_FACE_WORKERS=0
NAS_AI_VISION_IMAGE_MAX_TOKENS=512
NAS_AI_VISION_CTX_SIZE=8192
NAS_AI_VISION_BATCH_SIZE=128
NAS_AI_VISION_UBATCH_SIZE=64
NAS_AI_VISION_GPU_LAYERS=99
NAS_AI_MAX_EXTRACT_MB=16
NAS_AI_PDF_OCR_PAGES=20
NAS_AI_VECTORS_ON_DISK=true
NAS_AI_SHM_SIZE=1gb
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1

# AMD ROCm only when the GPU needs a compatibility override.
HSA_OVERRIDE_GFX_VERSION=
ROCR_VISIBLE_DEVICES=0

# Vulkan device selection for Intel or unsupported AMD GPU.
GGML_VK_VISIBLE_DEVICES=0

# NVIDIA NAS overlay paths.
NAS_LLAMA_RUNTIME_PATH=./runtime/llama-cuda
NAS_CUDA_LIB_PATH=/usr/local/cuda-12.8/targets/x86_64-linux/lib
