ARG NAS_AI_BASE_IMAGE=ghcr.io/hongjiahao371-pixel/nas-ai-space:1.4.1
FROM ${NAS_AI_BASE_IMAGE}
WORKDIR /opt/nas-ai-space
RUN apt-get update && apt-get install -y --no-install-recommends fonts-wqy-zenhei && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements.lock.txt ./
# Apply the audited PDF parser fix while preserving appliance-specific dependencies.
RUN python -m pip install --no-cache-dir pypdf==6.19.0 python-docx==1.2.0 python-pptx==1.0.2 reportlab==5.0.1 && python -m pip check
COPY app ./app

COPY scripts/restore-recovery.py ./scripts/restore-recovery.py
