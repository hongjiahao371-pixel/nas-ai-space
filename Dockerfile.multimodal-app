ARG NAS_AI_BASE_IMAGE=ghcr.io/hongjiahao371-pixel/nas-ai-space:1.4.1
FROM ${NAS_AI_BASE_IMAGE} AS sqlite-build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*
COPY scripts/build-sqlite.py /tmp/build-sqlite.py
RUN python /tmp/build-sqlite.py /sqlite

FROM ${NAS_AI_BASE_IMAGE}
COPY --from=sqlite-build /sqlite/libsqlite3.so.0 /usr/local/lib/libsqlite3.so.0
RUN ldconfig && python -c "import sqlite3; assert sqlite3.sqlite_version_info >= (3, 51, 3)"
WORKDIR /opt/nas-ai-space
RUN apt-get update && apt-get install -y --no-install-recommends ghostscript fonts-wqy-zenhei && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements.lock.txt ./
# Apply the audited PDF parser fix while preserving appliance-specific dependencies.
RUN python -m pip install --no-cache-dir pypdf==6.19.0 python-docx==1.2.0 python-pptx==1.0.2 reportlab==5.0.1 && python -m pip check
COPY scripts/pin-search-pages.py /usr/local/bin/nas-ai-pin-search-pages.py
COPY app ./app

COPY scripts/restore-recovery.py ./scripts/restore-recovery.py
